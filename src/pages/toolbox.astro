---
import Shell from '../layouts/Shell.astro';
import skills from '../data/skills.json';
import {toolboxGroups} from '../data/toolbox';
const installed = new Set(skills.map(skill => skill.name));
const described = new Set(toolboxGroups.flatMap(group => group.tools.map(tool => tool.name)));
const missing = skills.filter(skill => !described.has(skill.name));
if (missing.length) throw new Error(`请为新增工具补充网站文案：${missing.map(skill => skill.name).join(', ')}`);
const groups = toolboxGroups.map(group => ({...group, tools: group.tools.filter(tool => installed.has(tool.name))})).filter(group => group.tools.length);
---
<Shell title="工具箱 · Runze Zhang" description="写作、绘图，以及昇腾开发相关的工具目录。" active="toolbox">
  <section class="page-intro wrap"><p class="eyebrow">手边的工具</p><h1>工具箱</h1><p>写作、绘图，以及昇腾开发相关的 {skills.length} 个 Skill。按用途放在这里，方便查找。</p></section>
  <div class="toolbox-layout wrap">
    <aside class="tool-index"><nav aria-label="工具分类">{groups.map(group => <a href={`#${group.id}`}>{group.title}<span>{group.tools.length}</span></a>)}</nav><p>涉及硬件的工具，需要在对应环境中使用。</p></aside>
    <div class="toolbox">{groups.map(group => <section class="tool-group" id={group.id} aria-labelledby={`${group.id}-title`}><header><h2 id={`${group.id}-title`}>{group.title}</h2><p>{group.description}</p></header><div class="skill-list">{group.tools.map(tool => <div class="skill-item"><h3>{tool.title}</h3><p>{tool.summary}</p><code>{tool.name}</code></div>)}</div></section>)}</div>
  </div>
</Shell>
